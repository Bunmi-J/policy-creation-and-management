{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "listallanddownload",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "*",
                "arn:aws:s3:::bj-teacher-demo"
            ]
        },
        {
            "Sid": "upload",
            "Effect": "Allow",
            "Action": "s3:PutObject",
            "Resource": "arn:aws:s3:::bj-teacher-demo/*"
        },
        {
            "Sid": "avoiddelete",
            "Effect": "Deny",
            "Action": [
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "arn:aws:s3:::bj-teacher-demo/*"
        }
    ]
}
