{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "listallbuckets",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:ListBucket"
            ],
            "Resource": [
                "*",
                "arn:aws:s3:::bjstudent-demo"
            ]
        },
        {
            "Sid": "download",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": [
                "*",
                "arn:aws:s3:::bjstudent-demo/*"
            ]
        },
        {
            "Sid": "avoiddelete",
            "Effect": "Deny",
            "Action": [
                "s3:DeleteObject",
                "s3:DeleteObjectVersion",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::bjstudent-demo/*"
        }
    ]
}
